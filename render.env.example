# Render production environment template for DynamicQR backend
# Copy these key/value pairs into Render -> Web Service -> Environment.
# Do NOT commit real secrets.

APP_ENV=production

# Database
DATABASE_URL=mysql+asyncmy://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30

# JWT/Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OAUTH_TOKEN_ENCRYPTION_KEY=<BASE64_32BYTE_KEY>

# Optional internal service token
SERVICE_JWT_SECRET=local-service-secret-change-me
SERVICE_JWT_ALGORITHM=HS256
SERVICE_JWT_ISSUER=dynamicqr-internal
SERVICE_JWT_AUDIENCE=dynamicqr-tracking

# Redis cache + queue
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_SHORT_CODE_TTL_SECONDS=300

# Queue backend (current stable mode)
QUEUE_BACKEND=memory
QUEUE_URL=
DLQ_NAME=scan_logs_dlq
SCAN_LOG_QUEUE_NAME=scan_logs
QUEUE_MAX_RETRY_ATTEMPTS=5
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30

# Analytics scheduler
ANALYTICS_CRON_INTERVAL_MINUTES=5

# Google integrations
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=https://dynamicqr-backend.onrender.com/api/v1/integrations/callback
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_API_SECRET=

# CORS
# IMPORTANT: list fields must be JSON arrays for pydantic-settings on Render.
CORS_ALLOW_ORIGINS=["https://dynamicqr-fontend.vercel.app"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
