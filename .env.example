APP_ENV=local
DATABASE_URL=mysql+asyncmy://user:password@host:3306/dynamic_qr_marketing
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT_SECONDS=30
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_fernet_key
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_SHORT_CODE_TTL_SECONDS=300
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_API_SECRET=
GOOGLE_CLIENT_ID=361210084874-44em42shnfofehkpkb2mgm8u51eok7uc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Local OAuth callback. On Render/prod, set APP_ENV=production and replace this with:
# https://<your-backend-service>.onrender.com/api/v1/integrations/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/callback

# Local frontend origins. On Render/prod, replace with deployed frontend origins only.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Queue backend:
# - auto  : production non-local + non-local REDIS_URL/QUEUE_URL => redis, otherwise memory
# - memory: force in-memory queue
# - redis : force redis queue
QUEUE_BACKEND=auto
QUEUE_URL=
DLQ_NAME=scan_logs_dlq
SCAN_LOG_QUEUE_NAME=scan_logs
QUEUE_MAX_RETRY_ATTEMPTS=5
QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
ANALYTICS_CRON_INTERVAL_MINUTES=5

# IP Geolocation (MaxMind GeoLite2)
# Download database: python scripts/download_geolite2.py <license_key>
# Get free license key: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
MAXMIND_LICENSE_KEY=your_license_key_here
GEOLITE2_DB_PATH=data/GeoLite2-City.mmdb
